<Window x:Class="Shelf.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Shelf — 第2段階" Width="320" Height="500"
 Topmost="True" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="Manual"
 AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
 SourceInitialized="Window_SourceInitialized" Closing="Window_Closing" Background="#F4F6FA">
 <Border BorderBrush="#8795AC" BorderThickness="1">
  <Grid>
   <Grid x:Name="ExpandedContent" Margin="10">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
     <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,8">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
      <Button Content="‹" Click="Collapse_Click" ToolTip="折り畳む" AutomationProperties.Name="折り畳む" Width="30" Margin="0,0,4,0"/>
      <Button Content="×" Click="Exit_Click" ToolTip="終了" AutomationProperties.Name="終了" Width="30"/>
     </StackPanel>
     <TextBlock Text="Shelf" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </DockPanel>
    <StackPanel Grid.Row="1" Margin="0,0,0,8">
     <TextBlock Text="配置先（位置・解像度は物理px）" FontSize="11"/>
     <ComboBox x:Name="MonitorPicker" SelectionChanged="MonitorPicker_SelectionChanged"
      ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}"
      AutomationProperties.Name="配置先モニター" HorizontalContentAlignment="Stretch">
      <ComboBox.ItemTemplate>
       <DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap" MaxWidth="500"/></DataTemplate>
      </ComboBox.ItemTemplate>
     </ComboBox>
    </StackPanel>
    <TextBlock x:Name="PersistenceWarning" Grid.Row="2" Foreground="#9A3600" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,4"/>
    <ListBox x:Name="FileList" Grid.Row="3" ItemsSource="{Binding Items}"
     SelectionMode="Single" HorizontalContentAlignment="Stretch"
     PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
     PreviewMouseMove="FileList_PreviewMouseMove">
     <ListBox.ItemTemplate>
      <DataTemplate>
       <StackPanel Margin="4" ToolTip="{Binding FilePath}">
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding FilePath}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="#606875"/>
        <TextBlock Text="{Binding Availability}" TextWrapping="Wrap" FontSize="11" Foreground="#9A3600"/>
       </StackPanel>
      </DataTemplate>
     </ListBox.ItemTemplate>
    </ListBox>
    <Button Grid.Row="4" Content="選択項目を棚から取り除く" Click="Remove_Click" Margin="0,8,0,6" Padding="6"/>
    <TextBlock x:Name="Status" Grid.Row="5" Text="ファイルをドロップして登録。取り出しても棚に残ります。"
     TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
   </Grid>
   <Button x:Name="CollapsedStrip" Visibility="Collapsed" Click="Expand_Click" Padding="0"
    Background="#E2E8F2" BorderThickness="0" AutomationProperties.Name="棚を展開（右クリックでモニター選択・終了）">
    <StackPanel>
     <TextBlock Text="›" FontSize="25" HorizontalAlignment="Center"/>
     <TextBlock x:Name="CollapsedCount" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"/>
     <TextBlock x:Name="CollapsedWarning" Text="!" Visibility="Collapsed" Foreground="#9A3600" HorizontalAlignment="Center"/>
    </StackPanel>
   </Button>
  </Grid>
 </Border>
</Window>
